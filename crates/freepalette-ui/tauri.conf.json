{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freepalette",
  "version": "0.5.0",
  "identifier": "org.freepalette.app",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "freepalette",
        "width": 720,
        "height": 420,
        "minWidth": 480,
        "minHeight": 280,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/icons/freepalette-32.png",
      "../../assets/icons/freepalette-256.png",
      "../../assets/icons/freepalette.ico"
    ]
  }
}
